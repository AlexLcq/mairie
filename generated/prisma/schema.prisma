// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TableUser {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  password  String
  email     String  @unique
  firstname String
  lastname  String
  role      String  @default("USER")
  autorized Boolean @default(true)

  incidentsByUsername TableIncident[] @relation("IncidentByUsername")
}

model TableService {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  type         String
  status       String
  description  String
  localisation String
}

model TableObject {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  type       String
  status     String
  location   String
  lastUpdate DateTime
}

model TableIncident {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  description String
  status      String
  location    String

  username           String
  reportedByUsername TableUser @relation("IncidentByUsername", fields: [username], references: [username])
}

model TableActu {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    String
  title       String
  description String
  date        DateTime
}
